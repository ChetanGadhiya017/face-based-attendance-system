# Copy to .env and adjust. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string

# Default: SQLite file in instance/. For MySQL (schema from docs/dbms is compatible):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/face_attendance
DATABASE_URL=

# Face recognition tuning
RECOGNITION_THRESHOLD=0.42
RECOGNITION_MARGIN=0.05
LATE_AFTER_MINUTES=10
MIN_ATTENDANCE_PERCENT=75

# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0
